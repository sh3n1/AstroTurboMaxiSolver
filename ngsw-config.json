{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/assets/icon/favicon.png",
          "/index.html",
          "/manifest.webmanifest",
          "/assets/build-info.json",
          "/*.css",
          "/*.js",
          "/assets/data/*.json",
          "/assets/data/aggregate/*/*.json"
        ]
      }
    },
    {
      "name": "sky-brightness",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": ["/assets/data/aggregate/falchi/*.bin"]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"]
      }
    }
  ]
}
